{
  "expo": {
    "name": "Savify",
    "slug": "savify-mobile",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "8104b9d2-34c5-47a7-9df2-322b0649924b"
      },
      "buildNumber": 1
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savify-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.savify.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Savify uses Face ID to protect your financial data.",
        "NSCameraUsageDescription": "Savify uses your camera to scan receipts and bills.",
        "NSPhotoLibraryUsageDescription": "Savify accesses your photo library to scan receipts and bills.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Savify uses the microphone so you can say your expenses instead of typing them.",
        "NSSpeechRecognitionUsageDescription": "Savify turns what you say into an expense or income entry."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.savify.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Savify accesses your photo library to scan receipts and bills.",
          "cameraPermission": "Savify uses your camera to scan receipts and bills."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Savify uses Face ID to protect your financial data."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4f46e5",
          "sounds": [],
          "androidMode": "default",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Savify uses the microphone so you can say your expenses instead of typing them.",
          "speechRecognitionPermission": "Savify turns what you say into an expense or income entry.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Track spending, bills, loans and savings \u2014 simple, private and free."
  }
}
